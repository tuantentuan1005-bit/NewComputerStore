@model List<NewComputerStore.Models.EmailLog>
@{
    ViewData["Title"] = "Lịch sử gửi Email";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="bi bi-envelope-paper-fill me-2 text-primary"></i>Lịch sử gửi Email</h1>
</div>

<!-- Search & Filters -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="EmailLogs" class="row gx-3 gy-2 align-items-center">
            <div class="col-sm-5 col-md-4 col-lg-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm border-start-0" placeholder="Tìm người nhận, tiêu đề...">
                </div>
            </div>
            <div class="col-sm-4 col-md-3 col-lg-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    @if (ViewBag.StatusFilter == "Success") { <option value="Success" selected>Thành công</option> } else { <option value="Success">Thành công</option> }
                    @if (ViewBag.StatusFilter == "Failed")  { <option value="Failed"  selected>Thất bại</option>    } else { <option value="Failed">Thất bại</option>    }
                    @if (ViewBag.StatusFilter == "Skipped") { <option value="Skipped" selected>Bị bỏ qua</option>  } else { <option value="Skipped">Bị bỏ qua</option>  }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm px-3 fw-bold"><i class="bi bi-filter"></i> Lọc</button>
                <a asp-action="EmailLogs" class="btn btn-outline-secondary btn-sm px-3">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<!-- Logs Table -->
<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 80px;">ID</th>
                        <th>Người nhận</th>
                        <th>Tiêu đề</th>
                        <th>Loại thư</th>
                        <th>Thời gian gửi</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-3" style="width: 120px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var badgeClass = item.Status switch
                            {
                                "Success" => "bg-success",
                                "Failed"  => "bg-danger",
                                "Skipped" => "bg-secondary",
                                _         => "bg-dark"
                            };

                            var statusText = item.Status switch
                            {
                                "Success" => "Thành công",
                                "Failed"  => "Thất bại",
                                "Skipped" => "Bị bỏ qua",
                                _         => item.Status
                            };

                            var typeBadgeClass = item.EmailType switch
                            {
                                "ConfirmEmail"    => "bg-primary-subtle text-primary border border-primary",
                                "WelcomeEmail"    => "bg-success-subtle text-success border border-success",
                                "ResetPassword"   => "bg-warning-subtle text-warning border border-warning",
                                "OrderCreated"    => "bg-info-subtle text-info border border-info",
                                "OrderConfirmed"  => "bg-info-subtle text-info border border-info",
                                "OrderShipping"   => "bg-info-subtle text-info border border-info",
                                "OrderDelivered"  => "bg-success-subtle text-success border border-success",
                                "OrderCancelled"  => "bg-danger-subtle text-danger border border-danger",
                                "SecurityAlert"   => "bg-danger-subtle text-danger border border-danger",
                                "DiagnosticTest"  => "bg-warning-subtle text-warning border border-warning",
                                _                 => "bg-secondary-subtle text-secondary"
                            };

                            <tr>
                                <td class="ps-3 text-muted">#@item.Id</td>
                                <td>
                                    <div class="fw-semibold">@item.Receiver</div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;" title="@item.Subject">@item.Subject</div>
                                </td>
                                <td>
                                    <span class="badge @typeBadgeClass text-uppercase fs-6" style="font-size: 0.7rem !important; padding: 4px 8px;">@item.EmailType</span>
                                </td>
                                <td>
                                    <div class="small">@item.SentTime.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <span class="badge @badgeClass">@statusText</span>
                                    @if(item.Status == "Failed" && !string.IsNullOrEmpty(item.ErrorMessage))
                                    {
                                        <i class="bi bi-info-circle text-danger ms-1" style="cursor: pointer;" title="@item.ErrorMessage"></i>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 btn-view-email" data-id="@item.Id">
                                        <i class="bi bi-eye"></i> Xem thư
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                                Không tìm thấy lịch sử thư nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-sm">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="EmailLogs" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.StatusFilter" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Email Viewer Modal -->
<div class="modal fade" id="emailViewerModal" tabindex="-1" aria-labelledby="emailViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="emailViewerModalLabel"><i class="bi bi-envelope-open-fill me-2 text-primary"></i>Chi tiết Email gửi đi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="background-color: #f8f9fa; max-height: 70vh; overflow-y: auto;">
                <!-- Full HTML content loaded dynamically here in iframe to isolate styles -->
                <iframe id="emailFrame" style="width: 100%; height: 550px; border: none; background: #f8f9fa;"></iframe>
            </div>
            <div class="modal-footer border-0 bg-white py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-view-email').click(function () {
                var emailId = $(this).data('id');
                
                // Show loading placeholder in iframe
                var doc = document.getElementById('emailFrame').contentWindow.document;
                doc.open();
                doc.write("<p style='text-align:center;font-family:sans-serif;margin-top:50px;color:#888;'>Đang tải nội dung thư...</p>");
                doc.close();
                
                $('#emailViewerModal').modal('show');
                
                $.ajax({
                    url: '/Admin/GetEmailDetails',
                    type: 'GET',
                    data: { id: emailId },
                    success: function (response) {
                        if (response && response.body) {
                            var iframe = document.getElementById('emailFrame');
                            var frameDoc = iframe.contentWindow.document;
                            frameDoc.open();
                            frameDoc.write(response.body);
                            frameDoc.close();
                        }
                    },
                    error: function () {
                        var frameDoc = document.getElementById('emailFrame').contentWindow.document;
                        frameDoc.open();
                        frameDoc.write("<p style='text-align:center;color:red;font-family:sans-serif;margin-top:50px;'>Không thể tải nội dung email.</p>");
                        frameDoc.close();
                    }
                });
            });
        });
    </script>
}
