@model List<NewComputerStore.ViewModels.SlowSellingProductViewModel>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Báo cáo Phân tích Bán chậm - New Computer Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #fff !important;
            color: #333 !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12px;
            padding: 20px;
        }
        .report-header {
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .logo-section {
            font-size: 24px;
            font-weight: bold;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .logo-icon {
            background: #e94560;
            color: #fff;
            padding: 5px 10px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .report-title {
            text-align: center;
            margin-top: 10px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 18px;
            color: #111;
        }
        .summary-card {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
        }
        .table th {
            background-color: #f1f3f5 !important;
            color: #333 !important;
            font-weight: 600;
            border-bottom: 2px solid #dee2e6;
        }
        .table td, .table th {
            padding: 8px 6px;
            vertical-align: middle;
        }
        .badge {
            font-weight: 500;
            padding: 4px 8px;
            font-size: 10px;
        }
        .badge-status-danger { background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; } /* Ế nặng */
        .badge-status-warning { background-color: #fff3cd; color: #664d03; border: 1px solid #ffecb5; } /* Bán chậm */
        .badge-status-purple { background-color: #e2d9f3; color: #4b2386; border: 1px solid #d2c0ee; } /* Tồn kho nguy hiểm */
        .badge-status-secondary { background-color: #e2e3e5; color: #41464b; border: 1px solid #d3d6d8; } /* Dead stock */
        .badge-status-success { background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; } /* Ổn định */
        
        @@media print {
            body {
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
            .page-break {
                page-break-before: always;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Control buttons -->
        <div class="row mb-4 no-print">
            <div class="col-12 text-end">
                <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> In Báo cáo</button>
                <button onclick="window.close()" class="btn btn-outline-secondary">Đóng cửa sổ</button>
            </div>
        </div>

        <!-- Header -->
        <div class="report-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <div class="logo-section">
                        <span class="logo-icon"><i class="bi bi-cpu"></i></span>
                        <span>NEW COMPUTER STORE</span>
                    </div>
                    <div class="text-muted mt-1 small">
                        Địa chỉ: Khu công nghệ cao, Hà Nội<br/>
                        Website: www.newcomputerstore.com
                    </div>
                </div>
                <div class="col-6 text-end">
                    <div><strong>Mã báo cáo:</strong> RPT-SLOW-@DateTime.Now.ToString("yyyyMMddHHmmss")</div>
                    <div><strong>Ngày xuất:</strong> @ViewBag.ExportDate</div>
                    <div><strong>Người lập:</strong> @ViewBag.AdminName</div>
                </div>
            </div>
            <div class="report-title">BÁO CÁO PHÂN TÍCH SẢN PHẨM BÁN CHẬM (@ViewBag.ReportType)</div>
        </div>

        <!-- Summary -->
        <div class="summary-card">
            <div class="row">
                <div class="col-md-3 col-6 border-end">
                    <div class="text-muted small text-uppercase">Tổng số sản phẩm</div>
                    <h4 class="mb-0 fw-bold">@Model.Count SP</h4>
                </div>
                <div class="col-md-3 col-6 border-end">
                    <div class="text-muted small text-uppercase">Tổng giá trị tồn kho</div>
                    <h4 class="mb-0 fw-bold text-danger">@NewComputerStore.Helpers.LocalizationHelper.FormatCurrency(Model.Sum(p => p.InventoryValue))</h4>
                </div>
                <div class="col-md-3 col-6 border-end">
                    <div class="text-muted small text-uppercase">Nguy hiểm & Dead Stock</div>
                    <h4 class="mb-0 fw-bold text-warning">@Model.Count(p => p.Status == "Tồn kho nguy hiểm" || p.Status == "Dead stock") SP</h4>
                </div>
                <div class="col-md-3 col-6">
                    <div class="text-muted small text-uppercase">Khuyến nghị giảm giá</div>
                    <h4 class="mb-0 fw-bold text-success">@Model.Count(p => p.SuggestedPromotion.Contains("Giảm giá") || p.SuggestedPromotion.Contains("Sale")) SP</h4>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th style="width: 55px;">Mã</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th class="text-end">Giá gốc</th>
                        <th class="text-center">Giảm %</th>
                        <th class="text-end">Giá sau giảm</th>
                        <th class="text-center">Đã bán</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-end">Trị giá tồn</th>
                        <th class="text-center">Lượt xem</th>
                        <th class="text-center">CR (%)</th>
                        <th>Ngày bán cuối</th>
                        <th class="text-center">Chưa bán</th>
                        <th>Trạng thái</th>
                        <th>HeatScore</th>
                        <th>Khuyến nghị</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var badgeClass = p.Status switch
                        {
                            "Ế nặng" => "badge-status-danger",
                            "Bán chậm" => "badge-status-warning",
                            "Tồn kho nguy hiểm" => "badge-status-purple",
                            "Dead stock" => "badge-status-secondary",
                            "Ổn định" => "badge-status-success",
                            _ => "badge-status-success"
                        };
                        <tr>
                            <td class="text-center fw-bold">#@p.ProductId</td>
                            <td>@p.ProductName</td>
                            <td>@p.CategoryName</td>
                            <td class="text-end">@p.Price.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (p.DiscountPercent > 0)
                                {
                                    <span class="badge bg-danger">-@p.DiscountPercent.ToString("0")%</span>
                                }
                                else
                                {
                                    <span>0%</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-danger">@p.FinalPrice.ToString("N0") đ</td>
                            <td class="text-center">@p.TotalSold</td>
                            <td class="text-center">@p.StockQuantity</td>
                            <td class="text-end fw-bold">@p.InventoryValue.ToString("N0") đ</td>
                            <td class="text-center">@p.ViewCount</td>
                            <td class="text-center">@p.ConversionRate.ToString("0.##")%</td>
                            <td>@(p.LastSoldDate.HasValue ? p.LastSoldDate.Value.ToString("dd/MM/yyyy") : "Chưa bán")</td>
                            <td class="text-center">@p.DaysSinceLastSale ngày</td>
                            <td><span class="badge @badgeClass">@p.Status</span></td>
                            <td class="text-center">@p.HeatScore.ToString("0.##")</td>
                            <td><small>@p.SuggestedPromotion (@p.SuggestedReason)</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="row mt-5 text-center small text-muted">
            <div class="col-12">
                Báo cáo này được tạo tự động bởi hệ thống Quản lý New Computer Store.<br/>
                © @DateTime.Now.Year New Computer Store. Bảo lưu mọi quyền.
            </div>
        </div>
    </div>

    <script>
        window.onload = function() {
            // Auto open print dialog
            setTimeout(function() {
                window.print();
            }, 800);
        };
    </script>
</body>
</html>
