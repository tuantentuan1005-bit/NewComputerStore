@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="display-1 text-danger"><i class="bi bi-shield-lock-fill"></i></h1>
            <h2 class="h3 font-weight-bold my-3">Access Denied</h2>
            <p class="text-muted">You do not have permission to view this directory or page using the credentials that you supplied.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Return to Home</a>
        </div>
    </div>
</div>
