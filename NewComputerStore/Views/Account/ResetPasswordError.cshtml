@{
    ViewData["Title"] = "Liên kết khôi phục mật khẩu hết hạn";
}

<div class="container py-5 animate-in">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden text-center">
                <div class="bg-danger p-5 text-white">
                    <i class="bi bi-exclamation-octagon fs-1 display-1 bounce"></i>
                    <h2 class="fw-bold mt-3 mb-0">Liên Kết Hết Hạn</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <p class="fs-5 text-muted mb-4">
                        @ViewData["ErrorMessage"]
                    </p>

                    <div class="alert alert-warning border-0 rounded-3 p-3 mb-4 text-start">
                        <h6 class="fw-bold mb-2"><i class="bi bi-info-circle-fill me-2"></i>Lưu ý về bảo mật:</h6>
                        <p class="small text-muted mb-0">
                            Vì lý do an toàn, các liên kết khôi phục mật khẩu qua email chỉ có hiệu lực tối đa trong vòng <strong>15 phút</strong> kể từ lúc yêu cầu. Vui lòng quay lại và thực hiện yêu cầu mới.
                        </p>
                    </div>

                    <div class="d-flex gap-3 justify-content-center">
                        <a asp-action="ForgotPassword" class="btn btn-primary btn-lg rounded-pill fw-bold px-4 shadow-sm">
                            Yêu cầu liên kết mới
                        </a>
                        <a asp-action="Login" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold px-4">
                            Quay lại Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
