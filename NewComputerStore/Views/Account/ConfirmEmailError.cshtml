@{
    ViewData["Title"] = "Lỗi xác thực email";
}

<div class="container py-5 animate-in">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden text-center">
                <div class="bg-danger p-5 text-white">
                    <i class="bi bi-x-circle fs-1 display-1 bounce"></i>
                    <h2 class="fw-bold mt-3 mb-0">Xác Thực Thất Bại</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <p class="fs-5 text-muted mb-4">
                        @ViewData["ErrorMessage"]
                    </p>

                    @if (ViewData["ResendEmail"] != null)
                    {
                        <div class="alert alert-warning border-0 rounded-3 p-3 mb-4 text-start">
                            <h6 class="fw-bold mb-2">Gửi lại email xác thực:</h6>
                            <form asp-action="ResendConfirmation" method="post">
                                <input type="hidden" name="email" value="@ViewData["ResendEmail"]" />
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-warning fw-bold rounded-pill px-4 shadow-sm">
                                        <i class="bi bi-envelope-fill me-2"></i> Gửi lại liên kết kích hoạt
                                    </button>
                                </div>
                            </form>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-action="Login" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold px-5">
                            Quay lại Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
