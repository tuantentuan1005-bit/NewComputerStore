@model NewComputerStore.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container py-5 animate-in">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="bg-primary p-4 text-center text-white">
                    <i class="bi bi-key-fill fs-1"></i>
                    <h2 class="fw-bold mt-2 mb-0">Đặt Lại Mật Khẩu</h2>
                    <p class="opacity-75 mb-0">Thiết lập mật khẩu mới cho tài khoản của bạn</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                        
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div class="form-floating mb-3">
                            <input asp-for="NewPassword" class="form-control rounded-3" placeholder="Mật khẩu mới" />
                            <label asp-for="NewPassword">Mật khẩu mới</label>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmNewPassword" class="form-control rounded-3" placeholder="Xác nhận mật khẩu mới" />
                            <label asp-for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                        
                        <button type="submit" class="w-100 btn btn-primary btn-lg rounded-pill fw-bold shadow-sm py-3 mb-3">
                            Cập nhật Mật khẩu <i class="bi bi-check2-circle ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
