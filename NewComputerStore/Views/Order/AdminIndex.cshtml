@model IEnumerable<NewComputerStore.Models.Order>

@{
    ViewData["Title"] = LocalizationHelper.T("Manage Orders");
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">@LocalizationHelper.T("Orders")</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <form asp-action="AdminIndex" method="get" class="d-flex align-items-center">
            <label class="me-2 fw-semibold">@LocalizationHelper.T("Search"):</label>
            <select name="statusFilter" class="form-select form-select-sm w-auto me-2" onchange="this.form.submit()">
                <option value="">@LocalizationHelper.T("Status")</option>
                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">@LocalizationHelper.T("Pending")</option>
                <option value="Processing" selected="@(ViewBag.StatusFilter == "Processing")">@LocalizationHelper.T("Processing")</option>
                <option value="Shipped" selected="@(ViewBag.StatusFilter == "Shipped")">@LocalizationHelper.T("Shipped")</option>
                <option value="Delivered" selected="@(ViewBag.StatusFilter == "Delivered")">@LocalizationHelper.T("Delivered")</option>
                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">@LocalizationHelper.T("Cancelled")</option>
            </select>
            @if (!string.IsNullOrEmpty(ViewBag.StatusFilter))
            {
                <a asp-action="AdminIndex" class="btn btn-sm btn-outline-secondary">@LocalizationHelper.T("Clear")</a>
            }
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-2">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>@LocalizationHelper.T("Order ID")</th>
                <th>@LocalizationHelper.T("Customer")</th>
                <th>@LocalizationHelper.T("Created Date")</th>
                <th>@LocalizationHelper.T("Total")</th>
                <th>@LocalizationHelper.T("Status")</th>
                <th>@LocalizationHelper.T("Payment Method")</th>
                <th class="text-end">@LocalizationHelper.T("Actions")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="fw-bold">
                        <a asp-action="Details" asp-route-id="@item.OrderId" class="text-decoration-none">#@item.OrderId</a>
                    </td>
                    <td>
                        <div class="fw-bold">@item.FullName</div>
                        <small class="text-muted">@item.Phone</small><br>
                        <small class="text-muted">@item.Address</small>
                    </td>
                    <td>@LocalizationHelper.FormatDate(item.OrderDate)</td>
                    <td class="fw-bold text-primary">@LocalizationHelper.FormatCurrency(item.TotalPrice)</td>
                    <td>
                        <span class="badge @(item.Status == "Pending" ? "bg-warning text-dark" : (item.Status == "Completed" || item.Status == "Delivered" ? "bg-success" : (item.Status == "Cancelled" ? "bg-danger" : "bg-primary")))">
                            @LocalizationHelper.T(item.Status)
                        </span>
                    </td>
                    <td>
                        @if (item.PaymentMethod == "QR")
                        {
                            @if (item.PaymentStatus == "Paid")
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> @LocalizationHelper.T("QR (Paid)")</span>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Chờ TT</span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="ConfirmPayment" asp-route-id="@item.OrderId" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success py-0 px-2" 
                                                    onclick="return confirm('Xác nhận đã nhận được tiền chuyển khoản từ đơn #@item.OrderId?')">
                                                <i class="bi bi-check2"></i> Xác nhận
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">@LocalizationHelper.T("COD")</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end align-items-center">
                            <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center mb-0">
                                <input type="hidden" name="orderId" value="@item.OrderId" />
                                <select name="status" class="form-select form-select-sm d-inline-block w-auto me-2">
                                    @{
                                        int GetStatusLevel(string s) => s switch { "Pending" => 0, "Processing" => 1, "Shipped" => 2, "Delivered" => 3, _ => -1 };
                                        int currentLevel = GetStatusLevel(item.Status);
                                        var statuses = new[] { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };
                                    }
                                    @foreach(var st in statuses)
                                    {
                                        int stLevel = GetStatusLevel(st);
                                        bool isNext = (stLevel == currentLevel + 1);
                                        bool isQrBlocked = (item.PaymentMethod == "QR" && item.PaymentStatus != "Paid" && stLevel > 0 && st != "Cancelled");
                                        bool disabled = (st != "Cancelled" && stLevel != currentLevel && !isNext) || isQrBlocked;

                                        if (item.Status == st) {
                                            <option value="@st" selected>@LocalizationHelper.T(st)</option>
                                        } else if (disabled) {
                                            <option value="@st" disabled>@LocalizationHelper.T(st) @(isQrBlocked ? "(Chờ TT)" : "")</option>
                                        } else {
                                            <option value="@st">@LocalizationHelper.T(st)</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">@LocalizationHelper.T("Update")</button>
                            </form>
                            <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-info ms-2" title="View Details">
                                <i class="bi bi-eye"></i> @LocalizationHelper.T("Details")
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
