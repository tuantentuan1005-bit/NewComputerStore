@{
    ViewData["Title"] = LocalizationHelper.T("Order Success");
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center animate-in">
            <div class="card shadow border-0 rounded-4 p-5 bg-white">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 6rem;"></i>
                </div>
                <h1 class="fw-bold mb-3 display-5">@LocalizationHelper.T("Order Placed Successfully!")</h1>
                <p class="fs-4 text-muted mb-4">@LocalizationHelper.T("Thank you for your purchase.")</p>
                <div class="bg-light p-4 rounded-4 d-inline-block mb-5">
                    <h4 class="mb-0 fw-bold">@LocalizationHelper.T("Your Order ID is:") <span class="text-primary">#@ViewBag.OrderId</span></h4>
                </div>
                <div>
                    <a asp-controller="Order" asp-action="Details" asp-route-id="@ViewBag.OrderId" class="btn btn-outline-primary btn-lg rounded-pill px-5 me-3 fw-bold">@LocalizationHelper.T("View Order Details")</a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-gradient btn-lg rounded-pill px-5 fw-bold shadow">@LocalizationHelper.T("Continue Shopping")</a>
                </div>
            </div>
        </div>
    </div>
</div>
