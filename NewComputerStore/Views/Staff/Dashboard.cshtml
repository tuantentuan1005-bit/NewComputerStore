@model IEnumerable<NewComputerStore.Models.ProductColor>
@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var todayOrders = ViewBag.TodayOrders as List<NewComputerStore.Models.Order>;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Staff Dashboard</h1>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card text-white bg-primary shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-cart-check"></i> Orders Today</h5>
                <h2 class="display-4 fw-bold">@ViewBag.OrdersToday</h2>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card text-white bg-success shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-cash-coin"></i> Revenue Today</h5>
                <h2 class="display-4 fw-bold">@String.Format("{0:N0} VNĐ", ViewBag.RevenueToday)</h2>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">Today's Revenue Source</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order ID</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(todayOrders != null && todayOrders.Any()) {
                                foreach(var item in todayOrders) {
                                    <tr>
                                        <td class="fw-bold px-3">
                                            <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId" class="text-decoration-none" title="View Details">#@item.OrderId</a>
                                        </td>
                                        <td class="fw-bold text-dark">
                                            @String.Format("{0:N0} VNĐ", item.TotalPrice)
                                        </td>
                                        <td>
                                            <span class="badge @(item.Status == "Pending" ? "bg-warning text-dark" : (item.Status == "Completed" || item.Status == "Delivered" ? "bg-success" : (item.Status == "Cancelled" ? "bg-danger" : "bg-primary")))">
                                                @item.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            } else {
                                <tr><td colspan="3" class="text-center py-4 text-muted">No orders sold today yet.</td></tr>
                            }
                        </tbody>
                        @if(todayOrders != null && todayOrders.Any()) {
                            <tfoot class="table-light">
                                <tr>
                                    <td class="fw-bold text-end pe-3 text-uppercase small">Total Revenue:</td>
                                    <td colspan="2" class="fw-bold text-success fs-5">
                                        @String.Format("{0:N0} VNĐ", ViewBag.RevenueToday)
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white text-center">
                <a asp-controller="Order" asp-action="AdminIndex" class="text-decoration-none small text-muted">View All Orders</a>
            </div>
        </div>
    </div>

    <div class="col-xl-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">Stock Management</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Product Name</th>
                                <th>Color</th>
                                <th style="width: 150px;">Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model) {
                                <tr>
                                    <td class="px-3 text-truncate" style="max-width: 200px;" title="@item.Product?.ProductName">
                                        @item.Product?.ProductName
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span style="display:inline-block; width:12px; height:12px; background-color:@item.ColorCode; border-radius:50%; margin-right:6px; border:1px solid #ddd;"></span>
                                            <small>@item.ColorName</small>
                                        </div>
                                    </td>
                                    <td class="px-3">
                                        <form asp-controller="Product" asp-action="UpdateColorStock" method="post" class="d-flex gap-1 m-0">
                                            <input type="hidden" name="colorId" value="@item.Id" />
                                            <input type="number" name="quantity" value="@item.Quantity" class="form-control form-control-sm" style="width: 70px;" min="0" required />
                                            <button type="submit" class="btn btn-sm btn-success px-2" title="Save Stock">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
