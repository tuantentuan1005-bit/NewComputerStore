@model IEnumerable<NewComputerStore.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">@LocalizationHelper.T("Products")</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-circle"></i> @LocalizationHelper.T("Create New")
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>@LocalizationHelper.T("Image")</th>
                <th>@LocalizationHelper.T("Name")</th>
                <th>Màu sắc</th>
                <th>@LocalizationHelper.T("Price")</th>
                <th>@LocalizationHelper.T("Quantity")</th>
                <th>@LocalizationHelper.T("Categories")</th>
                <th class="text-end">@LocalizationHelper.T("Actions")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>
                        @if(!string.IsNullOrEmpty(item.ImageUrl)){
                            <img src="@Url.Content("~/images/" + item.ImageUrl)" asp-append-version="true" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                        } else {
                            <div class="bg-secondary rounded text-white text-center d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </td>
                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.ProductName)</td>
                    <td>
                        <div class="d-flex align-items-center flex-wrap gap-1">
                            @if (item.ProductColors != null)
                            {
                                foreach (var pc in item.ProductColors)
                                {
                                    <span style="display:inline-block; width:15px; height:15px; background-color:@pc.ColorCode; border-radius:50%; border:1px solid #ddd;" title="@pc.ColorName: @pc.Quantity"></span>
                                }
                            }
                        </div>
                    </td>
                    <td>
                        @if (item.DiscountPercent > 0)
                        {
                            <div><span class="text-decoration-line-through text-muted small">@LocalizationHelper.FormatCurrency(item.Price)</span> <span class="badge bg-danger">-@item.DiscountPercent.ToString("0")%</span></div>
                            <span class="text-danger fw-bold">@LocalizationHelper.FormatCurrency(item.FinalPrice)</span>
                        }
                        else
                        {
                            <span class="text-primary fw-bold">@LocalizationHelper.FormatCurrency(item.Price)</span>
                        }
                    </td>
                    <td>
                        @if(item.Quantity <= 5) {
                            <span class="badge bg-danger">@item.Quantity left</span>
                        } else {
                            <span class="badge bg-success">@item.Quantity</span>
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> @LocalizationHelper.T("Edit")</a>
                        <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> @LocalizationHelper.T("Delete")</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
