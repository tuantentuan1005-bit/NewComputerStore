@using NewComputerStore.Helpers
@model NewComputerStore.Models.Product

@{
    ViewData["Title"] = LocalizationHelper.T("Delete Product");
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mt-4 mb-4 text-danger">@LocalizationHelper.T("Delete Product")</h2>

<div class="alert alert-warning shadow-sm">
    <h4>@LocalizationHelper.T("Are you sure you want to delete this product?")</h4>
    <p class="mb-0">@LocalizationHelper.T("This action cannot be undone and will remove the product and its image.")</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-sm-4 text-center">
                        @if(!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="~/images/@Model.ImageUrl" class="img-fluid rounded border shadow-sm" />
                        }
                        else
                        {
                            <div class="bg-light p-4 rounded h-100 d-flex align-items-center justify-content-center">
                                <i class="bi bi-image text-muted fs-1"></i>
                            </div>
                        }
                    </div>
                    <div class="col-sm-8">
                        <h3 class="fw-bold mb-3">@Model.ProductName</h3>
                        <p class="fs-4 text-primary fw-bold">@LocalizationHelper.FormatCurrency(Model.Price)</p>
                        
                        <div class="d-flex mb-2">
                            <strong class="me-2" style="width: 100px;">@LocalizationHelper.T("Category"):</strong>
                            <span>@Model.Category?.CategoryName</span>
                        </div>
                        <div class="d-flex mb-2">
                            <strong class="me-2" style="width: 100px;">@LocalizationHelper.T("Quantity"):</strong>
                            <span>@Model.Quantity @LocalizationHelper.T("in stock")</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-between">
                <a asp-action="AdminIndex" class="btn btn-secondary">@LocalizationHelper.T("Cancel")</a>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="ProductId" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> @LocalizationHelper.T("Permanently Delete")</button>
                </form>
            </div>
        </div>
    </div>
</div>
