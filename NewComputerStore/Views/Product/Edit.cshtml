@using NewComputerStore.Helpers
@model NewComputerStore.ViewModels.ProductViewModel

@{
    ViewData["Title"] = LocalizationHelper.T("Edit Product");
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mt-4 mb-4">@LocalizationHelper.T("Edit Product")</h2>

<div class="row mb-5">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="ExistingImage" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@LocalizationHelper.T("Product Name")</label>
                            <input asp-for="ProductName" class="form-control" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@LocalizationHelper.T("Category")</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@LocalizationHelper.T("Price")</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@LocalizationHelper.T("Quantity")</label>
                            <input asp-for="Quantity" class="form-control" type="number" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@LocalizationHelper.T("Description")</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- ── Thông số kỹ thuật (Manual) ── -->
                    <div class="card border-0 bg-light rounded-4 mb-4">
                        <div class="card-header bg-transparent border-0 d-flex align-items-center justify-content-between pt-3 pb-0">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-cpu text-primary fs-5"></i>
                                <h6 class="fw-bold mb-0">@LocalizationHelper.T("Thông số kỹ thuật")</h6>
                            </div>
                            <button type="button" id="addCustomSpecBtn" class="btn btn-sm btn-primary rounded-pill px-3">
                                <i class="bi bi-plus-circle me-1"></i>@LocalizationHelper.T("Add Spec")
                            </button>
                        </div>
                        <div class="card-body pt-3">
                            <div id="customSpecsContainer">
                                @if (Model.CustomSpecs != null)
                                {
                                    for (int i = 0; i < Model.CustomSpecs.Count; i++)
                                    {
                                        <div class="row mb-2 custom-spec-row align-items-end">
                                            <div class="col-md-5">
                                                <label class="form-label small fw-bold">@LocalizationHelper.T("Tên thông số")</label>
                                                <input type="text" name="CustomSpecs[@i].Key" value="@Model.CustomSpecs[i].Key" class="form-control" required>
                                            </div>
                                            <div class="col-md-5">
                                                <label class="form-label small fw-bold">@LocalizationHelper.T("Giá trị")</label>
                                                <input type="text" name="CustomSpecs[@i].Value" value="@Model.CustomSpecs[i].Value" class="form-control" required>
                                            </div>
                                            <div class="col-md-2 text-end">
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill remove-spec-btn">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card bg-light border-0 rounded-4 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">@LocalizationHelper.T("Product Colors & Inventory")</h5>
                                <button type="button" id="addColorBtn" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-plus-circle me-1"></i>@LocalizationHelper.T("Add Variant")
                                </button>
                            </div>
                            
                            <div id="colorContainer">
                                @if (Model.ProductColors != null)
                                {
                                    for (int i = 0; i < Model.ProductColors.Count; i++)
                                    {
                                        <div class="color-row row g-2 mb-4 align-items-end border-bottom pb-3" data-index="@i">
                                            <input type="hidden" name="ProductColors[@i].Id" value="@Model.ProductColors[i].Id" />
                                            <input type="hidden" name="ProductColors[@i].ProductId" value="@Model.ProductColors[i].ProductId" />
                                            <input type="hidden" name="ProductColors[@i].ExistingImage" value="@Model.ProductColors[i].ExistingImage" />
                                            
                                            <div class="col-auto">
                                                <label class="small text-muted d-block">@LocalizationHelper.T("HEX")</label>
                                                <input type="color" name="ProductColors[@i].ColorCode" value="@Model.ProductColors[i].ColorCode" class="form-control form-control-color" style="width: 45px; height: 38px;" />
                                            </div>
                                            <div class="col">
                                                <label class="small text-muted d-block">@LocalizationHelper.T("Name (Red, Blue...)")</label>
                                                <input type="text" name="ProductColors[@i].ColorName" value="@Model.ProductColors[i].ColorName" class="form-control form-control-sm" required />
                                            </div>
                                            <div class="col-2">
                                                <label class="small text-muted d-block">@LocalizationHelper.T("Stock")</label>
                                                <input type="number" name="ProductColors[@i].Quantity" value="@Model.ProductColors[i].Quantity" class="form-control form-control-sm" min="0" required />
                                            </div>
                                            <div class="col-3">
                                                <label class="small text-muted d-block">@LocalizationHelper.T("Variant Image")</label>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(Model.ProductColors[i].ExistingImage))
                                                    {
                                                        <img src="@Url.Content("~/images/" + Model.ProductColors[i].ExistingImage)" asp-append-version="true" style="width: 38px; height: 38px; object-fit: cover;" class="rounded border">
                                                    }
                                                    <input type="file" name="ProductColors[@i].ColorImage" class="form-control form-control-sm" accept="image/*" />
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-color-btn" style="height: 38px;"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            
                            <div class="mt-2">
                                <span asp-validation-for="ProductColors" class="text-danger d-block mb-1"></span>
                                <div class="text-info small">
                                    <i class="bi bi-info-circle me-1"></i> @LocalizationHelper.T("Removing a variant here will delete it from the database upon saving.")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">@LocalizationHelper.T("Upload Image")</label>
                        <input name="ProductImage" class="form-control" type="file" accept="image/*" />
                        <small class="text-muted d-block mt-1">@LocalizationHelper.T("Leave empty to keep the existing image.")</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-images me-1 text-primary"></i> Ảnh bổ sung (Gallery / Carousel)
                        </label>

                        @if (Model.ExistingAdditionalImages != null && Model.ExistingAdditionalImages.Any())
                        {
                            <p class="text-muted small mb-2">Ảnh hiện có — nhấn <i class="bi bi-x-circle text-danger"></i> để xóa:</p>
                            <div class="row g-2 mb-3" id="existingGallery">
                                @foreach (var img in Model.ExistingAdditionalImages)
                                {
                                    <div class="col-6 col-md-3 position-relative existing-img-col" data-filename="@img">
                                        <div class="rounded-3 overflow-hidden border shadow-sm" style="aspect-ratio:1;">
                                            <img src="@Url.Content("~/images/" + img)" class="w-100 h-100" style="object-fit:cover;" />
                                        </div>
                                        <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute mark-delete-btn"
                                                style="top:6px;right:12px;width:26px;height:26px;padding:0;line-height:1;"
                                                data-filename="@img">
                                            <i class="bi bi-x" style="font-size:.85rem;"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            <div id="deleteInputsContainer"></div>
                        }

                        <!-- Drop zone for new images -->
                        <div id="dropZone" class="border border-2 border-dashed rounded-4 p-4 text-center bg-light mb-3"
                             style="cursor:pointer; border-color:#0d6efd55 !important; transition: all .2s;">
                            <i class="bi bi-cloud-upload text-primary" style="font-size:2.5rem;"></i>
                            <p class="text-muted mt-2 mb-1">Kéo thả ảnh vào đây hoặc <span class="text-primary fw-bold">nhấn để chọn</span></p>
                            <small class="text-muted">Hỗ trợ nhiều ảnh cùng lúc (JPG, PNG, WEBP)</small>
                            <input type="file" name="AdditionalImageUploads" id="additionalImagesInput"
                                   accept="image/*" multiple class="d-none" />
                        </div>
                        <!-- Preview new uploads -->
                        <div id="additionalImagesPreview" class="row g-2"></div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="AdminIndex" class="btn btn-secondary text-white rounded-pill px-4"><i class="bi bi-arrow-left me-1"></i>@LocalizationHelper.T("Back to List")</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-save me-1"></i>@LocalizationHelper.T("Save Changes")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white pt-3 border-0">
                <h5 class="mb-0 fw-bold">@LocalizationHelper.T("Current Image")</h5>
            </div>
            <div class="card-body text-center p-4">
                @if (!string.IsNullOrEmpty(Model.ExistingImage))
                {
                    <img src="@Url.Content("~/images/" + Model.ExistingImage)" asp-append-version="true" class="img-fluid rounded shadow-sm" alt="Current image">
                }
                else
                {
                    <div class="bg-light p-5 rounded-4">
                        <i class="bi bi-images text-muted" style="font-size: 4rem;"></i>
                        <p class="mt-3 text-muted">@LocalizationHelper.T("No Image Uploaded")</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const colorContainer = document.getElementById('colorContainer');
        const addColorBtn = document.getElementById('addColorBtn');

        function reindexColors() {
            const rows = colorContainer.querySelectorAll('.color-row');
            rows.forEach((row, index) => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/ProductColors\[\d+\]/, `ProductColors[${index}]`));
                    }
                });
            });
        }

        // --- Custom Specs Logic ---
        const customSpecsContainer = document.getElementById('customSpecsContainer');
        const addCustomSpecBtn = document.getElementById('addCustomSpecBtn');

        function addCustomSpecRow() {
            const index = customSpecsContainer.querySelectorAll('.custom-spec-row').length;
            const row = document.createElement('div');
            row.className = 'row mb-2 custom-spec-row align-items-end';
            row.innerHTML = `
                <div class="col-md-5">
                    <label class="form-label small fw-bold">@LocalizationHelper.T("Tên thông số")</label>
                    <input type="text" name="CustomSpecs[${index}].Key" class="form-control" placeholder="@LocalizationHelper.T("Ví dụ: Tần số quét")" required>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-bold">@LocalizationHelper.T("Giá trị")</label>
                    <input type="text" name="CustomSpecs[${index}].Value" class="form-control" placeholder="@LocalizationHelper.T("Ví dụ: 144Hz")" required>
                </div>
                <div class="col-md-2 text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill remove-spec-btn">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            customSpecsContainer.appendChild(row);
            
            row.querySelector('.remove-spec-btn').addEventListener('click', function() {
                row.remove();
                reindexCustomSpecs();
            });
        }

        function reindexCustomSpecs() {
            const rows = customSpecsContainer.querySelectorAll('.custom-spec-row');
            rows.forEach((row, index) => {
                row.querySelectorAll('input').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/CustomSpecs\[\d+\]/, `CustomSpecs[${index}]`));
                    }
                });
            });
        }

        // Initialize removal listeners for existing spec rows
        customSpecsContainer.querySelectorAll('.remove-spec-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                btn.closest('.custom-spec-row').remove();
                reindexCustomSpecs();
            });
        });

        addCustomSpecBtn.addEventListener('click', addCustomSpecRow);

        function addColorRow() {
            const index = colorContainer.querySelectorAll('.color-row').length;
            const row = document.createElement('div');
            row.className = 'color-row row g-2 mb-4 align-items-end border-bottom pb-3';
            row.innerHTML = `
                <input type="hidden" name="ProductColors[${index}].Id" value="0" />
                <input type="hidden" name="ProductColors[${index}].ProductId" value="@Model.ProductId" />
                <input type="hidden" name="ProductColors[${index}].ExistingImage" value="" />
                <div class="col-auto">
                    <label class="small text-muted d-block">@LocalizationHelper.T("HEX")</label>
                    <input type="color" name="ProductColors[${index}].ColorCode" value="#000000" class="form-control form-control-color" style="width: 45px; height: 38px;" />
                </div>
                <div class="col">
                    <label class="small text-muted d-block">@LocalizationHelper.T("Name (Red, Blue...)")</label>
                    <input type="text" name="ProductColors[${index}].ColorName" class="form-control form-control-sm" required />
                </div>
                <div class="col-2">
                    <label class="small text-muted d-block">@LocalizationHelper.T("Stock")</label>
                    <input type="number" name="ProductColors[${index}].Quantity" value="0" class="form-control form-control-sm" min="0" required />
                </div>
                <div class="col-3">
                    <label class="small text-muted d-block">@LocalizationHelper.T("Variant Image")</label>
                    <input type="file" name="ProductColors[${index}].ColorImage" class="form-control form-control-sm" accept="image/*" />
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-color-btn" style="height: 38px;"><i class="bi bi-trash"></i></button>
                </div>
            `;
            colorContainer.appendChild(row);
            
            row.querySelector('.remove-color-btn').addEventListener('click', function() {
                row.remove();
                reindexColors();
            });
        }

        // Initialize removal listeners for existing color rows
        colorContainer.querySelectorAll('.remove-color-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                btn.closest('.color-row').remove();
                reindexColors();
            });
        });

        addColorBtn.addEventListener('click', addColorRow);

        // ── Existing image delete marking ──
        document.querySelectorAll('.mark-delete-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const filename = this.dataset.filename;
                const col = this.closest('.existing-img-col');
                // Visual feedback
                col.style.opacity = '0.35';
                this.disabled = true;
                // Add hidden input to signal deletion to server
                const container = document.getElementById('deleteInputsContainer');
                if (container) {
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'DeleteAdditionalImages';
                    hidden.value = filename;
                    container.appendChild(hidden);
                }
            });
        });

        // ── Multi-image upload with drop zone ──
        (function() {
            const dropZone  = document.getElementById('dropZone');
            const fileInput = document.getElementById('additionalImagesInput');
            const preview   = document.getElementById('additionalImagesPreview');
            let selectedFiles = [];

            dropZone.addEventListener('click', () => fileInput.click());

            dropZone.addEventListener('dragover', e => {
                e.preventDefault();
                dropZone.style.borderColor = '#0d6efd';
                dropZone.style.background  = '#eef3ff';
            });
            dropZone.addEventListener('dragleave', () => {
                dropZone.style.borderColor = '#0d6efd55';
                dropZone.style.background  = '';
            });
            dropZone.addEventListener('drop', e => {
                e.preventDefault();
                dropZone.style.borderColor = '#0d6efd55';
                dropZone.style.background  = '';
                addFiles(e.dataTransfer.files);
            });

            fileInput.addEventListener('change', () => {
                addFiles(fileInput.files);
                fileInput.value = '';
            });

            function addFiles(files) {
                Array.from(files).forEach(file => {
                    if (!file.type.startsWith('image/')) return;
                    selectedFiles.push(file);
                    renderPreview(file, selectedFiles.length - 1);
                });
                syncFileInput();
            }

            function renderPreview(file, idx) {
                const reader = new FileReader();
                reader.onload = e => {
                    const col = document.createElement('div');
                    col.className = 'col-6 col-md-3 position-relative';
                    col.dataset.idx = idx;
                    col.innerHTML = `
                        <div class="rounded-3 overflow-hidden border shadow-sm" style="aspect-ratio:1;">
                            <img src="${e.target.result}" class="w-100 h-100" style="object-fit:cover;">
                        </div>
                        <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute"
                                style="top:6px;right:12px;width:26px;height:26px;padding:0;line-height:1;"
                                onclick="removeNewImg(${idx})">
                            <i class="bi bi-x" style="font-size:.85rem;"></i>
                        </button>
                        <div class="text-truncate small text-muted mt-1 px-1">${file.name}</div>`;
                    preview.appendChild(col);
                };
                reader.readAsDataURL(file);
            }

            window.removeNewImg = function(idx) {
                selectedFiles[idx] = null;
                const col = preview.querySelector(`[data-idx="${idx}"]`);
                if (col) col.remove();
                syncFileInput();
            };

            function syncFileInput() {
                const dt = new DataTransfer();
                selectedFiles.filter(f => f !== null).forEach(f => dt.items.add(f));
                fileInput.files = dt.files;
            }
        })();
    </script>
}
