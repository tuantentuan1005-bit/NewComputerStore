<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NewComputerStore</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">NewComputerStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@LocalizationHelper.T("Home")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">@LocalizationHelper.T("Products")</a>
                        </li>
                    </ul>
                    
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-bold" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3"></i> @LocalizationHelper.T("Giỏ hàng")
                            </a>
                        </li>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-primary" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> @LocalizationHelper.T("Admin Panel")</a>
                                </li>
                            }
                            else if (User.IsInRole("Staff") || User.IsInRole("WarehouseManager") || User.IsInRole("EmployeeManager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-primary" asp-controller="Order" asp-action="AdminIndex"><i class="bi bi-speedometer2"></i> @LocalizationHelper.T("Staff Panel")</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Account" asp-action="MyAccount">@LocalizationHelper.T("Tài khoản")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Order" asp-action="Index">@LocalizationHelper.T("Đơn mua")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-danger" asp-controller="Account" asp-action="Logout">@LocalizationHelper.T("Đăng xuất")</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Account" asp-action="Login">@LocalizationHelper.T("Login")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Account" asp-action="Register">@LocalizationHelper.T("Register")</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Spacer for fixed navbar -->
    <div style="height: 76px;"></div>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5 py-4 bg-white">
        <div class="container text-center">
            &copy; 2026 - NewComputerStore - @LocalizationHelper.T("Built with ASP.NET Core MVC & Bootstrap 5")
        </div>
    </footer>
    <partial name="_CustomerChatPartial" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
