@using System.Security.Claims
@if (User.Identity.IsAuthenticated)
{
    <div id="customer-chat-widget" class="d-none d-md-block">
        <!-- Floating Button -->
        <button id="chat-toggle-btn" class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; position: fixed; bottom: 30px; right: 30px; z-index: 1050; transition: transform 0.3s;">
            <i class="bi bi-chat-dots-fill fs-3"></i>
            <span id="chat-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
        </button>

        <!-- Chat Popup -->
        <div id="chat-popup" class="card shadow-2xl border-0 rounded-4 d-none" style="position: fixed; bottom: 100px; right: 30px; width: 380px; height: 550px; z-index: 1050; overflow: hidden; background: #fff;">
            <!-- Header -->
            <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between py-3 px-4 border-0" style="flex-shrink: 0;">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center text-primary" style="width: 35px; height: 35px;">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Hỗ trợ trực tuyến</h6>
                        <small class="opacity-75" id="staff-status">Nhân viên đang online</small>
                        <div id="chat-status" class="small fw-bold" style="font-size: 0.65rem;"></div>
                    </div>
                </div>
                <button type="button" id="chat-close-btn" class="btn-close btn-close-white" aria-label="Close"></button>
            </div>
            
            <!-- Body (Messages) -->
            <div class="card-body p-0 d-flex flex-column" style="flex: 1 1 auto; overflow: hidden; background: #f8f9fa; min-height: 0;">
                <div id="chat-messages" class="p-3" style="flex: 1 1 auto; overflow-y: auto; scroll-behavior: smooth;">
                    <!-- Messages will be loaded here -->
                </div>
                
                <div id="typing-indicator" class="px-3 py-1 small text-muted d-none" style="flex-shrink: 0;">
                    <span class="fw-bold" id="typing-user">Nhân viên</span> đang nhập...
                </div>
            </div>

            <!-- Footer (Input) -->
            <div class="card-footer bg-white p-3 border-top" style="flex-shrink: 0; z-index: 10;">
                <div class="input-group">
                    <input type="text" id="chat-input" class="form-control rounded-pill border-light bg-light" placeholder="Nhập tin nhắn..." autocomplete="off">
                    <button class="btn btn-primary rounded-circle ms-2 d-flex align-items-center justify-content-center" id="chat-send-btn" style="width: 40px; height: 40px; flex-shrink: 0;">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.currentUserId = @User.FindFirstValue(ClaimTypes.NameIdentifier);
    </script>

    <style>
        /* Floating Widget & Toggle */
        #chat-toggle-btn { 
            width: 60px; height: 60px; position: fixed; bottom: 30px; right: 30px; z-index: 1051; 
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 25px rgba(37, 99, 235, 0.4);
        }
        #chat-toggle-btn:hover { transform: scale(1.1) translateY(-5px); box-shadow: 0 12px 30px rgba(37, 99, 235, 0.5); }
        
        /* Main Chat Popup - Modern Glass/Floating Panel */
        #chat-popup {
            position: fixed; bottom: 100px; right: 30px; width: 380px; height: 580px; z-index: 1050;
            background: #ffffff;
            border: 1px solid rgba(229, 231, 235, 0.8);
            border-radius: 24px;
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.15),
                0 10px 20px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            animation: chatFadeIn 0.4s ease-out;
            display: none; /* Controlled by :not(.d-none) */
        }
        
        #chat-popup:not(.d-none) { display: flex !important; flex-direction: column !important; }

        @@keyframes chatFadeIn {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Header Area */
        .card-header {
            background: linear-gradient(135deg, #2563eb, #1d4ed8) !important;
            padding: 20px !important;
            flex-shrink: 0;
            border-bottom: 0 !important;
        }

        /* Body Area - Light Background for depth */
        .card-body {
            background: #f5f7fb !important;
            flex: 1 1 auto;
            overflow: hidden;
            min-height: 0;
        }

        #chat-messages { 
            padding: 20px !important;
            display: flex; flex-direction: column; 
            flex: 1 1 auto; overflow-y: auto; scroll-behavior: smooth; 
        }
        #chat-messages::-webkit-scrollbar { width: 4px; }
        #chat-messages::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 10px; }

        /* Footer Area - Floating Input */
        .card-footer {
            background: #ffffff !important;
            padding: 16px 20px !important;
            border-top: 1px solid #e5e7eb !important;
            flex-shrink: 0;
            z-index: 10;
        }

        /* Input Styling */
        #chat-input {
            border: 2px solid #e5e7eb !important;
            border-radius: 999px !important;
            padding: 10px 20px !important;
            background: #ffffff !important;
            transition: all 0.2s ease;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }
        #chat-input:focus {
            outline: none !important;
            border-color: #2563eb !important;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15) !important;
            background: #fff !important;
        }

        /* Messenger/Zalo Style Messages with Shadows */
        .chat-message { display: flex; margin-bottom: 18px; width: 100%; align-items: flex-end; }
        .chat-message.customer { justify-content: flex-end; }
        .chat-message.staff { justify-content: flex-start; }

        .message-content { max-width: 75%; display: flex; flex-direction: column; }
        .customer .message-content { align-items: flex-end; }
        .staff .message-content { align-items: flex-start; }

        .message-bubble { 
            padding: 12px 16px; font-size: 0.95rem; line-height: 1.4;
            transition: transform 0.2s ease;
        }
        .message-bubble:hover { transform: translateY(-1px); }
        
        .customer .message-bubble { 
            background: #2563eb; 
            color: white; 
            border-radius: 20px 20px 4px 20px; 
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }
        
        .staff .message-bubble { 
            background: #ffffff; 
            color: #111827; 
            border-radius: 20px 20px 20px 4px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .message-time { font-size: 0.65rem; margin-top: 5px; opacity: 0.5; font-weight: 500; }
        
        .product-card-msg { 
            background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; 
            overflow: hidden; max-width: 250px; color: #333;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }
        .product-card-msg img { width: 100%; height: 130px; object-fit: cover; }
        .product-card-body { padding: 12px; }
        .product-card-title { font-weight: 600; font-size: 0.9rem; margin-bottom: 6px; }
        .product-card-price { color: #dc3545; font-weight: 700; font-size: 0.9rem; }
    </style>
}
