@model IEnumerable<NewComputerStore.Models.SpecGroup>
@{
    ViewData["Title"] = "Quản lý thông số kỹ thuật";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="mb-0">Quản lý Thông số kỹ thuật</h2>
    <div class="d-flex gap-2">
        <form asp-action="ClearAllSpecs" method="post" onsubmit="return confirm('CẢNH BÁO: Hành động này sẽ xóa TOÀN BỘ thông số kỹ thuật đã cấu hình và dữ liệu thông số của tất cả sản phẩm. Bạn có chắc chắn muốn làm sạch dữ liệu để tự tạo lại từ đầu?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-eraser-fill me-1"></i>Xóa toàn bộ dữ liệu cũ</button>
        </form>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Thêm Nhóm mới</a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Loại sản phẩm</th>
                    <th>Tên Nhóm</th>
                    <th>Thứ tự</th>
                    <th>Thuộc tính</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold text-primary">@item.Category?.CategoryName</td>
                        <td class="fw-bold text-dark">@item.Name</td>
                        <td><span class="badge bg-light text-dark border">@item.DisplayOrder</span></td>
                        <td>
                            @if (item.SpecKeys != null && item.SpecKeys.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach(var key in item.SpecKeys)
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">@key.Name</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic small">Chưa có thuộc tính</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-gear"></i> Cấu hình</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhóm này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
