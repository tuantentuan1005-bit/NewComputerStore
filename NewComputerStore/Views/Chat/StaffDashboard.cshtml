@{
    ViewData["Title"] = "Tư vấn khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="chat-admin-wrapper bg-white shadow-sm rounded-4 overflow-hidden" style="height: calc(100vh - 120px); border: 1px solid #eef0f2;">
    <div class="d-flex h-100">
        
        <!-- Column 1: Conversation List (Left) -->
        <div class="chat-sidebar border-end d-flex flex-column bg-white" style="width: 320px; flex-shrink: 0;">
            <div class="p-3 border-bottom bg-light bg-opacity-50">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold mb-0">Hội thoại</h6>
                    <span class="badge bg-primary rounded-pill" id="total-conv-count">0</span>
                </div>
                <div class="search-box position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted small"></i>
                    <input type="text" id="search-chat" class="form-control form-control-sm ps-5 rounded-pill border-light" placeholder="Tìm theo tên KH...">
                </div>
            </div>
            <div id="conversation-list" class="flex-grow-1 overflow-auto">
                <div class="text-center p-5 text-muted small">Đang tải...</div>
            </div>
        </div>

        <!-- Column 2: Chat Main Area (Middle) -->
        <div class="chat-main flex-grow-1 d-flex flex-column overflow-hidden bg-white">
            
            <div id="chat-welcome" class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 bg-light bg-opacity-25">
                <div class="welcome-icon mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-chat-dots text-primary fs-2"></i>
                    </div>
                </div>
                <h5 class="fw-bold">Trung tâm hỗ trợ</h5>
                <p class="text-muted small">Chọn một khách hàng để bắt đầu tư vấn</p>
            </div>

            <div id="chat-active" class="d-none flex-column flex-grow-1 position-relative overflow-hidden">
                <!-- Header -->
                <div class="chat-header p-3 border-bottom d-flex align-items-center justify-content-between bg-white shadow-sm" style="z-index: 5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 40px; height: 40px;">
                            <span id="active-customer-initial">K</span>
                        </div>
                        <div>
                            <h6 id="active-customer-name" class="fw-bold mb-0 small">---</h6>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success rounded-circle p-1" style="width: 8px; height: 8px;"></span>
                                <small class="text-muted smaller">Đang trực tuyến</small>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold border-2" id="btn-close-chat" style="font-size: 0.75rem;">
                        <i class="bi bi-check-circle me-1"></i> Kết thúc chat
                    </button>
                </div>

                <!-- Messages -->
                <div id="admin-chat-messages" class="flex-grow-1 p-4 overflow-auto" style="background: #f9fafb; display: flex; flex-direction: column; gap: 15px;">
                    <!-- Messages content -->
                </div>

                <div id="admin-typing" class="px-4 py-1 smaller text-muted bg-white d-none border-top">
                    <span class="fw-bold" id="admin-typing-user">Khách hàng</span> đang nhập...
                </div>

                <!-- Footer / Input (Strictly Fixed at Bottom) -->
                <div class="chat-footer p-3 border-top bg-white flex-shrink-0 sticky-bottom">
                    <div class="d-flex gap-2 mb-2">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border rounded-pill dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" style="font-size: 0.75rem;">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Phản hồi nhanh
                            </button>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-3" id="quick-replies-list" style="font-size: 0.8rem;"></ul>
                        </div>
                        <button class="btn btn-sm btn-light border rounded-pill px-3" id="btn-send-product" style="font-size: 0.75rem;">
                            <i class="bi bi-plus-circle me-1"></i> Gửi sản phẩm
                        </button>
                    </div>
                    <div class="input-group shadow-sm rounded-pill overflow-hidden border-2 focus-within-primary">
                        <input type="text" id="admin-chat-input" class="form-control border-0 bg-light px-4 py-2" placeholder="Nhập câu trả lời cho khách hàng..." style="font-size: 0.95rem;">
                        <button class="btn btn-primary px-4 border-0" id="admin-chat-send">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Column 3: Customer Details (Right) -->
        <div id="customer-info-panel" class="chat-info border-start bg-white flex-column" style="width: 320px; flex-shrink: 0;">
            <div class="p-3 border-bottom bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Hồ sơ khách hàng</h6>
                <button class="btn btn-sm btn-light rounded-circle" onclick="$('#customer-info-panel').addClass('d-none')"><i class="bi bi-x-lg"></i></button>
            </div>
            
            <div class="info-content flex-grow-1 overflow-auto p-4">
                <div id="info-empty" class="text-center py-5 text-muted">
                    <i class="bi bi-person-bounding-box fs-1 mb-3 d-block opacity-25"></i>
                    Chưa chọn khách hàng
                </div>

                <div id="info-loaded" class="d-none">
                    <div class="text-center mb-4">
                        <div class="avatar-lg bg-light text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow-sm border" style="width: 80px; height: 80px;">
                            <i class="bi bi-person-fill fs-1"></i>
                        </div>
                        <h5 id="info-name" class="fw-bold mb-1">---</h5>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Thành viên</span>
                    </div>

                    <div class="info-group mb-4">
                        <label class="text-muted smaller fw-bold text-uppercase mb-2 d-block">Liên hệ</label>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-envelope text-muted"></i>
                            <span id="info-email" class="small text-truncate">---</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone text-muted"></i>
                            <span id="info-phone" class="small">---</span>
                        </div>
                    </div>

                    <div class="info-group mb-4">
                        <label class="text-muted smaller fw-bold text-uppercase mb-2 d-block">Thống kê mua hàng</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="p-2 bg-light rounded text-center">
                                    <div class="smaller text-muted">Tổng đơn</div>
                                    <div id="info-total-orders" class="fw-bold">0</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded text-center">
                                    <div class="smaller text-muted">Chi tiêu</div>
                                    <div id="info-total-spent" class="fw-bold text-success">0₫</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="info-group mb-4">
                        <label class="text-muted smaller fw-bold text-uppercase mb-2 d-block">Đơn hàng gần nhất</label>
                        <div id="info-orders" class="list-group list-group-flush gap-1"></div>
                    </div>

                    <div class="info-group mb-4">
                        <label class="text-muted smaller fw-bold text-uppercase mb-2 d-block">Sản phẩm đã mua</label>
                        <div id="info-products" class="d-flex flex-wrap gap-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Product Picker Modal -->
<div class="modal fade" id="productPickerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Tìm sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="search-product position-relative mb-3">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" id="search-product-input" class="form-control rounded-pill ps-5 bg-light border-0" placeholder="Nhập tên sản phẩm...">
                </div>
                <div id="product-search-results" class="list-group list-group-flush">
                    <div class="text-center py-4 text-muted small">Nhập tên sản phẩm để tìm kiếm</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-sidebar { border-right: 1px solid #eef0f2; }
    .chat-list-item { 
        padding: 12px 20px; cursor: pointer; transition: all 0.2s; 
        border-bottom: 1px solid #f8f9fa; margin: 4px 10px; border-radius: 12px;
    }
    .chat-list-item:hover { background: #f8f9fa; }
    .chat-list-item.active { background: #eef4ff; border: 1px solid #dce8ff; }
    
    /* Message Rows */
    .chat-message { display: flex; width: 100%; gap: 12px; align-items: flex-start; }
    .chat-message.customer { flex-direction: row; }
    .chat-message.staff { flex-direction: row-reverse; }

    .message-content { max-width: 70%; display: flex; flex-direction: column; }
    .customer .message-content { align-items: flex-start; }
    .staff .message-content { align-items: flex-end; }

    /* Bubbles */
    .message-bubble { 
        padding: 12px 18px; font-size: 0.95rem; line-height: 1.5;
        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
    }
    
    .customer .message-bubble { 
        background: #ffffff; color: #111827; border: 1px solid #e5e7eb;
        border-radius: 18px 18px 18px 4px;
    }
    
    .staff .message-bubble { 
        background: #2563eb; color: white;
        border-radius: 18px 18px 4px 18px;
    }

    .message-time { font-size: 0.7rem; margin-top: 5px; opacity: 0.6; }
    
    .msg-avatar { width: 32px; height: 32px; flex-shrink: 0; border: 1px solid #eee; }

    .status-badge { font-size: 0.65rem; padding: 2px 8px; border-radius: 100px; font-weight: bold; }
    .status-Waiting { background: #fff3cd; color: #856404; }
    .status-Open { background: #d1ecf1; color: #0c5460; }
    .status-Answered { background: #d4edda; color: #155724; }
    .status-Closed { background: #f3f4f6; color: #4b5563; }

    .focus-within-primary:focus-within { border-color: #2563eb !important; }
    .smaller { font-size: 0.8rem; }
    .btn-xs { padding: 4px 10px; font-size: 0.75rem; }

    #chat-active:not(.d-none),
    #customer-info-panel:not(.d-none) {
        display: flex !important;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        var adminConnection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();
        var selectedConversationId = null;
        var selectedCustomerId = null;

        adminConnection.onreconnected(id => {
            if (selectedConversationId) adminConnection.invoke("JoinConversation", selectedConversationId);
        });

        adminConnection.on("ReceiveMessage", function (msg) {
            if (msg.conversationId === selectedConversationId) {
                appendAdminMessage(msg);
                scrollToAdminBottom();
                markAsRead(selectedConversationId);
            }
            loadConversations(true);
        });

        adminConnection.on("GlobalNewMessage", function () {
            loadConversations(true);
        });

        adminConnection.on("UserTyping", function (conversationId) {
            if (conversationId === selectedConversationId) {
                $("#admin-typing").removeClass("d-none");
                setTimeout(() => $("#admin-typing").addClass("d-none"), 3000);
            }
        });

        adminConnection.start().then(() => loadConversations());

        async function loadConversations(isUpdate = false) {
            const res = await fetch("/Chat/GetConversations");
            const data = await res.json();
            const list = $("#conversation-list");
            $("#total-conv-count").text(data.length);
            
            const searchTerm = $("#search-chat").val().toLowerCase();
            const filteredData = data.filter(c => c.customerName.toLowerCase().includes(searchTerm));
            
            list.empty();
            filteredData.forEach(c => {
                const isActive = c.id === selectedConversationId ? "active" : "";
                const badge = c.unreadCount > 0 ? `<span class="badge rounded-pill bg-danger ms-2">${c.unreadCount}</span>` : "";
                
                list.append(`
                    <div class="chat-list-item ${isActive}" data-id="${c.id}" onclick="selectConversation(${c.id}, '${c.customerName}', ${c.customerId})">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="fw-bold text-truncate small">${c.customerName}</div>
                            <small class="text-muted smaller">${c.lastMessageAt}</small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted text-truncate w-75 smaller">${c.lastMessage}</small>
                            ${badge}
                        </div>
                        <div class="mt-2">
                            <span class="status-badge status-${c.status}">${c.status}</span>
                        </div>
                    </div>
                `);
            });
        }

        $("#search-chat").on("input", () => loadConversations(true));

        async function selectConversation(id, name, customerId) {
            if (selectedConversationId) adminConnection.invoke("LeaveConversation", selectedConversationId);
            
            selectedConversationId = id;
            selectedCustomerId = customerId;
            
            $("#chat-welcome").addClass("d-none");
            $("#chat-active").removeClass("d-none");
            $("#info-empty").addClass("d-none");
            $("#info-loaded").removeClass("d-none");
            $("#customer-info-panel").removeClass("d-none");
            
            $(".chat-list-item").removeClass("active");
            $(`.chat-list-item[data-id="${id}"]`).addClass("active");
            
            $("#active-customer-name").text(name);
            $("#active-customer-initial").text(name[0]);
            
            adminConnection.invoke("JoinConversation", id);
            loadAdminMessages(id);
            loadCustomerInfo(customerId);
            markAsRead(id);
            loadQuickReplies();
        }

        async function loadAdminMessages(id) {
            const res = await fetch(`/Chat/GetMessages?conversationId=${id}`);
            const messages = await res.json();
            $("#admin-chat-messages").empty();
            messages.forEach(appendAdminMessage);
            scrollToAdminBottom();
        }

        function appendAdminMessage(msg) {
            const isStaff = msg.isStaff;
            const messageClass = isStaff ? "staff" : "customer";
            let contentHtml = "";
            
            if (msg.type === "ProductCard") {
                const p = JSON.parse(msg.metadata);
                contentHtml = `
                    <div class="product-card-msg border bg-white rounded-3 overflow-hidden shadow-sm" style="width: 180px;">
                        <img src="/images/${p.image}" class="w-100" style="height:100px; object-fit:cover;">
                        <div class="p-2 small">
                            <div class="fw-bold text-truncate">${p.name}</div>
                            <div class="text-danger fw-bold">${p.price}</div>
                            <a href="/Product/Details/${p.id}" target="_blank" class="btn btn-xs btn-outline-primary w-100 mt-2 rounded-pill">Chi tiết</a>
                        </div>
                    </div>
                `;
            } else { contentHtml = `<span>${msg.content}</span>`; }

            const avatarHtml = isStaff 
                ? `<div class="msg-avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="font-size: 0.7rem;">ST</div>`
                : `<div class="msg-avatar rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center fw-bold" style="font-size: 0.7rem;">KH</div>`;

            $("#admin-chat-messages").append(`
                <div class="chat-message ${messageClass} mb-3">
                    <div class="avatar-col d-flex align-items-end">
                        ${avatarHtml}
                    </div>
                    <div class="message-content">
                        <div class="message-bubble">${contentHtml}</div>
                        <span class="message-time text-muted mt-1" style="font-size: 10px;">${msg.sentAt}</span>
                    </div>
                </div>
            `);
            scrollToAdminBottom();
        }

        async function loadCustomerInfo(customerId) {
            const res = await fetch(`/Chat/GetCustomerInfo?customerId=${customerId}`);
            const data = await res.json();
            
            $("#info-name").text(data.name);
            $("#info-email").text(data.email);
            $("#info-phone").text(data.phone);
            $("#info-total-orders").text(data.totalOrders);
            $("#info-total-spent").text(data.totalSpent);
            
            const ordersList = $("#info-orders");
            ordersList.empty();
            data.orders.forEach(o => {
                ordersList.append(`
                    <a href="/Order/Details/${o.id}" class="list-group-item list-group-item-action p-2 border-0 bg-light rounded mb-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold smaller">#${o.id}</span>
                            <span class="status-badge status-${o.status}" style="font-size:0.5rem">${o.status}</span>
                        </div>
                        <div class="d-flex justify-content-between smaller opacity-75 mt-1">
                            <span>${o.date}</span>
                            <span class="text-success fw-bold">${o.total}</span>
                        </div>
                    </a>
                `);
            });

            const prodList = $("#info-products");
            prodList.empty();
            data.products.forEach(p => {
                prodList.append(`<img src="/images/${p.image}" class="rounded border shadow-sm" style="width:45px; height:45px; object-fit:cover;" title="${p.name}">`);
            });
        }

        async function loadQuickReplies() {
            const res = await fetch("/Chat/GetQuickReplies");
            const data = await res.json();
            const list = $("#quick-replies-list").empty();
            data.forEach(q => {
                list.append(`<li><a class="dropdown-item py-2 px-3" href="#" onclick="sendQuickReply('${encodeURIComponent(q.content)}')">${q.content}</a></li>`);
            });
        }

        function sendQuickReply(content) {
            $("#admin-chat-input").val(decodeURIComponent(content));
            sendAdminMessage();
        }

        async function sendAdminMessage() {
            const content = $("#admin-chat-input").val();
            if (!content.trim() || !selectedConversationId) return;
            $("#admin-chat-input").val("").prop("disabled", true);
            
            await fetch("/Chat/SendMessage", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `conversationId=${selectedConversationId}&content=${encodeURIComponent(content)}`
            });
            $("#admin-chat-input").prop("disabled", false).focus();
            scrollToAdminBottom();
        }

        $("#admin-chat-send").click(sendAdminMessage);
        $("#admin-chat-input").keypress(e => { if (e.which == 13) sendAdminMessage(); });
        $("#btn-send-product").click(() => $("#productPickerModal").modal("show"));

        async function markAsRead(id) { await fetch(`/Chat/MarkRead?conversationId=${id}`, { method: "POST" }); loadConversations(true); }
        function scrollToAdminBottom() { 
            const container = document.getElementById("admin-chat-messages");
            if(container) container.scrollTop = container.scrollHeight; 
        }

        $("#btn-close-chat").click(async function() {
            if (confirm("Kết thúc phiên tư vấn này?")) {
                await fetch(`/Chat/CloseConversation?id=${selectedConversationId}`, { method: "POST" });
                location.reload();
            }
        });

        $("#search-product-input").on("input", async function() {
            const term = $(this).val();
            if (term.length < 2) return;
            const res = await fetch(`/Chat/SearchProducts?term=${encodeURIComponent(term)}`);
            const products = await res.json();
            const list = $("#product-search-results").empty();
            products.forEach(p => {
                list.append(`
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3" onclick="sendProductCard(${JSON.stringify(p).replace(/"/g, '&quot;')})">
                        <img src="/images/${p.image}" style="width:50px; height:50px; object-fit:cover;" class="rounded shadow-sm">
                        <div class="flex-grow-1">
                            <div class="fw-bold small">${p.name}</div>
                            <div class="text-danger fw-bold small">${p.price}</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </button>
                `);
            });
        });

        async function sendProductCard(p) {
            $("#productPickerModal").modal("hide");
            await fetch("/Chat/SendMessage", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `conversationId=${selectedConversationId}&content=Gửi sản phẩm: ${p.name}&type=ProductCard&metadata=${encodeURIComponent(JSON.stringify(p))}`
            });
        }
    </script>
}
