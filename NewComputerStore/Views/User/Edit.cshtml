@model NewComputerStore.Models.User
@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isPrimaryAdmin = Model.Email == "admin@store.com";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Chỉnh sửa người dùng: @Model.Email</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">Email</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-bold">Họ và tên</label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label fw-bold">Vai trò</label>
                <select asp-for="Role" class="form-select" disabled="@(isPrimaryAdmin ? "disabled" : null)">
                    <option value="Customer">Khách hàng</option>
                    <option value="Staff">Nhân viên</option>
                    <option value="Admin">Quản trị viên</option>
                </select>
                @if (isPrimaryAdmin) {
                    <input type="hidden" asp-for="Role" value="@Model.Role" />
                    <small class="text-muted">Không thể thay đổi vai trò của quản trị viên chính.</small>
                }
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IsActive" class="form-label fw-bold">Trạng thái</label>
                <select asp-for="IsActive" class="form-select" disabled="@(isPrimaryAdmin ? "disabled" : null)">
                    <option value="true">Đang hoạt động</option>
                    <option value="false">Đã khóa</option>
                </select>
                @if (isPrimaryAdmin) {
                    <input type="hidden" name="IsActive" value="true" />
                    <small class="text-muted">Không thể khóa tài khoản quản trị viên chính.</small>
                }
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
            </div>
        </form>
    </div>
</div>

